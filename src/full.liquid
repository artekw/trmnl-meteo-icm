  <div class="wx">

    <div class="wx-top">
      <div class="wx-now">
        <div class="wx-head">Teraz ({{ nowl | date: '%H:%M' }})</div>
        <div class="wx-big">
          <svg class="ic"><use href="#wi-{{ icon_list[idx] }}"/></svg>
          <span class="wx-temp">{{ t.data[idx] | round }}°</span>
        </div>
        <div class="wx-desc">{{ desc_list[idx] }}</div>
      </div>

      <div class="wx-today">
        <div class="wx-head">Dziś &mdash; {{ wd[w_today] }}, {{ d_today }} {{ mo[m_today] }}</div>
        <div class="wx-sum">
          <svg class="ic"><use href="#wi-{{ icon_list[sel_today] }}"/></svg>
          <span class="wx-mm">{{ today_max | round }}°<br>{{ today_min | round }}°</span>
          <span class="wx-sumdesc">{{ desc_list[sel_today] }}</span>
        </div>
        <div class="wx-cells">
          {% for k in (1..7) %}
          {% assign i = idx | plus: k %}
          {% assign ts = i | times: step | plus: first | plus: off %}
          <div class="wx-cell">
            <div class="h">{{ ts | date: '%H' }}</div>
            <svg class="ic"><use href="#wi-{{ icon_list[i] }}"/></svg>
            <div class="v">{{ data.airtmp_point.data[i] | round }}°</div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="wx-bot">
      <div class="wx-head">Jutro &mdash; {{ wd[w_tom] }}</div>
      <div class="wx-botrow">
        <div class="wx-botsum">
          <div class="r">
            <svg class="ic" style="width:52px;height:52px;"><use href="#wi-{{ icon_list[sel_tom] }}"/></svg>
            <span class="wx-mm">{{ tom_max | round }}°<br>{{ tom_min | round }}°</span>
          </div>
          <div class="d">{{ desc_list[sel_tom] }}</div>
        </div>
        <div class="wx-botcells">
          <div class="wx-cells" style="border-top:none;padding-top:0;">
            {% for k in (0..6) %}
            {% assign i = idx_tom | plus: 7 | plus: k | plus: k %}
            {% assign ts = i | times: step | plus: first | plus: off %}
            {% if i < count %}
            <div class="wx-cell">
              <div class="h">{{ ts | date: '%H' }}</div>
              <svg class="ic"><use href="#wi-{{ icon_list[i] }}"/></svg>
              <div class="v">{{ data.airtmp_point.data[i] | round }}°</div>
            </div>
            {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

  </div>

  <div class="title_bar">
    <span class="title">{{ place }}</span>
    <span class="instance">Źródło: ICM UW</span>
  </div>
</div>
