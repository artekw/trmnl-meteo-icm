{% assign cf = trmnl.plugin_settings.custom_fields_values %}
{% assign lat = cf.lat | default: '54.1118' %}
{% assign lon = cf.lon | default: '22.9309' %}
{% assign place = cf.location_name | default: 'Suwałki' %}
{% assign t = data.airtmp_point %}
{% assign count = t.data.size %}
{% assign step = t.interval %}
{% if step < 60 %}{% assign step = step | times: 3600 %}{% endif %}
{% assign first = t.first_timestamp %}
{% assign now = 'now' | date: '%s' | plus: 0 %}
{% assign off = trmnl.user.utc_offset | default: 3600 %}
{% assign idx = now | minus: first | divided_by: step %}
{% assign nowl = now | plus: off %}
{% assign midl = nowl | modulo: 86400 | minus: nowl | times: -1 %}
{% assign tom_start = midl | plus: 86400 | minus: off %}
{% assign idx_tom = tom_start | minus: first | divided_by: step %}
{% assign idx_day0 = idx_tom | minus: 24 %}
{% if idx_day0 < 0 %}{% assign idx_day0 = 0 %}{% endif %}

{% assign amp = lat | times: 0.09 %}
{% assign noon = lon | divided_by: 15.0 | times: -1 | plus: 12 %}

{% assign icons = '' %}
{% assign descs = '' %}
{% for n in (0..119) %}
  {% if n < count %}
    {% assign tsu = n | times: step | plus: first %}
    {% assign dd = tsu | divided_by: 86400.0 %}
    {% assign doy = dd | modulo: 365.2425 %}
    {% assign dist = doy | minus: 172 | abs %}
    {% if dist > 182.6 %}{% assign dist = 365.2425 | minus: dist %}{% endif %}
    {% assign q = dist | divided_by: 91.3 %}
    {% assign sv = 1 | minus: q %}
    {% assign half = amp | times: sv | plus: 12 | divided_by: 2.0 %}
    {% assign hr = tsu | modulo: 86400 | divided_by: 3600.0 %}
    {% assign diff = hr | minus: noon %}
    {% if diff > 12 %}{% assign diff = diff | minus: 24 %}{% elsif diff < -12 %}{% assign diff = diff | plus: 24 %}{% endif %}
    {% assign diff = diff | abs %}
    {% assign dn = 'night' %}
    {% if diff < half %}{% assign dn = 'day' %}{% endif %}

    {% assign tmp = data.airtmp_point.data[n] | default: 0 %}
    {% assign pr = data.pcpttl_aver.data[n] | default: 0 %}
    {% assign cl = data.cldtot_aver.data[n] | default: 0 %}
    {% assign st = data.storm_max.data[n] | default: 0 %}
    {% assign fl = data.flash_max.data[n] | default: 0 %}
    {% assign vis = data.visibl_min.data[n] | default: 99999 %}

    {% assign icon = 'overcast' %}
    {% assign desc = 'Pochmurno' %}
    {% if st > 0 or fl > 0 %}
      {% assign icon = 'thunderstorms-rain' %}
      {% assign desc = 'Burza' %}
    {% elsif pr >= 0.1 %}
      {% if tmp <= 0 %}{% assign kind = 'snow' %}{% assign desc = 'Śnieg' %}
      {% elsif tmp <= 1.5 %}{% assign kind = 'sleet' %}{% assign desc = 'Deszcz ze śniegiem' %}
      {% elsif pr < 0.3 %}{% assign kind = 'drizzle' %}{% assign desc = 'Mżawka' %}
      {% else %}{% assign kind = 'rain' %}{% assign desc = 'Deszcz' %}{% endif %}
      {% if cl < 0.6 %}{% assign icon = 'partly-cloudy-' | append: dn | append: '-' | append: kind %}
      {% else %}{% assign icon = 'overcast-' | append: kind %}{% endif %}
    {% elsif vis < 1000 %}
      {% assign icon = 'fog-' | append: dn %}
      {% assign desc = 'Mgła' %}
    {% elsif cl < 0.15 %}
      {% assign icon = 'clear-' | append: dn %}
      {% if dn == 'day' %}{% assign desc = 'Słonecznie' %}{% else %}{% assign desc = 'Bezchmurnie' %}{% endif %}
    {% elsif cl < 0.6 %}
      {% assign icon = 'partly-cloudy-' | append: dn %}
      {% assign desc = 'Częściowe zachmurzenie' %}
    {% elsif cl < 0.85 %}
      {% assign icon = 'overcast-' | append: dn %}
      {% assign desc = 'Duże zachmurzenie' %}
    {% endif %}
    {% assign icons = icons | append: icon | append: ',' %}
    {% assign descs = descs | append: desc | append: '|' %}
  {% endif %}
{% endfor %}
{% assign icon_list = icons | split: ',' %}
{% assign desc_list = descs | split: '|' %}

{% assign today_max = -999 %}{% assign today_min = 999 %}{% assign today_pmax = 0 %}{% assign today_pidx = -1 %}
{% for j in (0..23) %}
  {% assign n = idx_day0 | plus: j %}
  {% if n < idx_tom and n < count %}
    {% assign v = t.data[n] %}
    {% if v != nil %}
      {% if v > today_max %}{% assign today_max = v %}{% endif %}
      {% if v < today_min %}{% assign today_min = v %}{% endif %}
    {% endif %}
    {% assign pv = data.pcpttl_aver.data[n] | default: 0 %}
    {% if n >= idx and pv > today_pmax %}{% assign today_pmax = pv %}{% assign today_pidx = n %}{% endif %}
  {% endif %}
{% endfor %}
{% assign sel_today = idx_tom | minus: 11 %}
{% if idx > sel_today %}{% assign sel_today = idx %}{% endif %}
{% if today_pmax >= 0.3 %}{% assign sel_today = today_pidx %}{% endif %}

{% assign tom_max = -999 %}{% assign tom_min = 999 %}{% assign tom_pmax = 0 %}{% assign tom_pidx = -1 %}
{% for j in (0..23) %}
  {% assign n = idx_tom | plus: j %}
  {% if n < count %}
    {% assign v = t.data[n] %}
    {% if v != nil %}
      {% if v > tom_max %}{% assign tom_max = v %}{% endif %}
      {% if v < tom_min %}{% assign tom_min = v %}{% endif %}
    {% endif %}
    {% assign pv = data.pcpttl_aver.data[n] | default: 0 %}
    {% if pv > tom_pmax %}{% assign tom_pmax = pv %}{% assign tom_pidx = n %}{% endif %}
  {% endif %}
{% endfor %}
{% assign sel_tom = idx_tom | plus: 13 %}
{% if tom_pmax >= 0.3 %}{% assign sel_tom = tom_pidx %}{% endif %}

{% assign wd = 'niedziela,poniedziałek,wtorek,środa,czwartek,piątek,sobota' | split: ',' %}
{% assign mo = 'stycznia,lutego,marca,kwietnia,maja,czerwca,lipca,sierpnia,września,października,listopada,grudnia' | split: ',' %}
{% assign w_today = nowl | date: '%w' | plus: 0 %}
{% assign w_tom = nowl | plus: 86400 | date: '%w' | plus: 0 %}
{% assign m_today = nowl | date: '%m' | plus: 0 | minus: 1 %}
{% assign d_today = nowl | date: '%d' | plus: 0 %}

